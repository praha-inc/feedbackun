{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "outputs": [
        "schema.graphql"
      ]
    },
    "build": {
      "dependsOn": [
        "generate"
      ],
      "outputs": [
        ".next/**",
        "dist/**"
      ]
    },
    "lint:type": {
      "dependsOn": [
        "generate"
      ]
    },
    "lint:code": {
      "dependsOn": [
        "generate"
      ]
    }
  }
}
